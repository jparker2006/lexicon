{
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "claude-haiku-5-5",
    "CLAUDE_CODE_SHELL": "/bin/bash",
    "CLAUDE_CODE_DISABLE_FAST_MODE": "1"
  },
  "permissions": {
    "allow": [
      "Edit(.claude/skills/**)",
      "Write(.claude/skills/**)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(gh pr update-branch:*)",
      "Workflow(lexicon-review)"
    ],
    "deny": [
      "Read(~/Library/Application Support/Lexicon)",
      "Read(~/Library/Application Support/Lexicon/**)",
      "Read(//**/.env)",
      "Read(//**/.env.*)",
      "Edit(~/Library/Application Support/Lexicon)",
      "Edit(~/Library/Application Support/Lexicon/**)",
      "Edit(//**/.env)",
      "Edit(//**/.env.*)",
      "Bash(*Application Support/Lexicon/*)",
      "Bash(*Application Support/Lexicon)",
      "Bash(*Application\\ Support/Lexicon/*)",
      "Bash(*Application\\ Support/Lexicon)",
      "Bash(* .env)",
      "Bash(* .env *)",
      "Bash(*/.env)",
      "Bash(*/.env *)",
      "Bash(security find-generic-password:*)",
      "Bash(security find-internet-password:*)",
      "Bash(security dump-keychain:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Grep|Glob|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "command -v node >/dev/null 2>&1 || { echo 'guard: node not found, refusing' >&2; exit 2; }; node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.mjs\" || { echo 'guard: failed, refusing' >&2; exit 2; }"
          }
        ]
      }
    ]
  }
}
